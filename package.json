{
  "name": "dukme",
  "private": true,
  "version": "0.1.0",
  "description": "덕메 - 내 덕질을 기억하는 AI 비서 (SNU x Croche AI Hackathon 2026)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env --import tsx src/server.ts",
