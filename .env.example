# 덕메 환경변수 예시. 이 파일을 .env로 복사해서 값을 채운다(.env는 git에 올리지 않는다).
# 키 값은 Croche Studio에서 발급. 절대 코드·레포·브라우저에 넣지 않는다.

# 공개 프로젝트 키 (필수)
CROCHE_PROJECT_KEY=
# 운영: 서버 키 (csk_…) — Render Environment에만
CROCHE_SERVER_KEY=
# 로컬 개발: 디버그 키 (cdt_…) — 서버 키가 있으면 서버 키를 쓴다
CROCHE_DEBUG_KEY=
# 익명 사용자 쿠키 서명용 (32자 이상, 예: openssl rand -hex 32). 운영 필수
SESSION_SECRET=

# 저장 위치 (기본: 프로젝트 폴더). Render 디스크는 /data
# DATA_DIR=/data
# PORT=3000
# HOST=0.0.0.0

# 부스 화면: 이 시간(초) 동안 입력이 없으면 자동으로 "처음부터". 0 또는 비우면 끔
# BOOTH_IDLE_RESET=180

# 비용 보호
# USER_MESSAGE_LIMIT=30
# GLOBAL_MESSAGES_PER_HOUR=600
# TOOL_CALLS_PER_TURN=12
# MAX_SESSIONS=50
# SESSION_IDLE_MINUTES=20
# NEW_USERS_PER_IP_PER_HOUR=100
# Render 같은 프록시 뒤면 1 (운영 NODE_ENV=production에서는 기본 1)
# TRUST_PROXY=1

# PayPal (developer.paypal.com > Apps & Credentials > Sandbox). Secret은 레포에 넣지 않는다.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox(기본) 또는 live
# PAYPAL_ENV=sandbox
# 원화 -> 달러 데모 환율
# KRW_PER_USD=1400
